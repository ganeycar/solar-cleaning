# Copy this file to .env.local and fill in values. Never commit .env.local.

# Public site URL (no trailing slash). Used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engines are told NOT to index the site until you set this to "true" at launch.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security, so it must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to hash visitor IPs for rate limiting (any long random string).
RATE_LIMIT_SALT=

# --- Stripe (TEST MODE keys only until launch is approved) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or from the webhook endpoint in the Stripe dashboard when deployed.
STRIPE_WEBHOOK_SECRET=
# The app refuses sk_live_ keys unless this is exactly "true". Set it only when you approve live payments.
STRIPE_LIVE_MODE_APPROVED=false

# --- Email (Resend: resend.com -> API Keys) ---
# Without a key, emails are logged on the Leads & emails page but not sent.
RESEND_API_KEY=
# Until your domain is verified in Resend, leave EMAIL_FROM empty (uses Resend's
# test sender) and set EMAIL_TEST_TO to the email you signed up to Resend with:
# every email then goes to you, with the real recipient in the subject.
EMAIL_FROM=
EMAIL_TEST_TO=
# Optional: where customers' replies go, and where owner alerts go
# (defaults to the business email on the Business page).
EMAIL_REPLY_TO=
OWNER_NOTIFY_EMAIL=

# --- Daily job (reminders, follow-ups, renewal notices) ---
# Any long random string (e.g. from `openssl rand -hex 24`). Vercel sends it to /api/cron/daily.
CRON_SECRET=
