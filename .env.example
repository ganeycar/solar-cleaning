# Copy this file to .env.local and fill in values. Never commit .env.local.

# Public site URL (no trailing slash). Used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engines are told NOT to index the site until you set this to "true" at launch.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security, so it must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to hash visitor IPs for rate limiting (any long random string).
RATE_LIMIT_SALT=

# --- Phase 3 (Stripe, TEST MODE keys only until launch is approved) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Phase 6 (email) ---
# RESEND_API_KEY=
# EMAIL_FROM="Solar Cleaning Co. <bookings@yourdomain.com>"
